{
  "expo": {
    "name": "VEGETA",
    "slug": "vegan-app-mma302",
    "scheme": "veganapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ngocthang.veganapp",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép VEGETA chọn hình ảnh cho trợ lý AI và nguyên liệu.",
          "cameraPermission": "Cho phép VEGETA chụp ảnh nguyên liệu.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép VEGETA dùng máy ảnh để nhận diện nguyên liệu."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#247A52"
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      "./plugins/withAndroidBuildStability.cjs"
    ]
  }
}
